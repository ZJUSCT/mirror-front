{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    ".cache",
    "dist",
    "node_modules",
    "playwright-report",
    "public",
    "test-results",
    "vendor"
  ],
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "~/*": ["src/*"]
    }
  }
}
