---
// Shared directory listing shell. NGINX serves this page for directory URLs;
// the browser fetches JSON from /<mirror>/.mirror-index/<directory>/.
// The build seals inline and shared scripts with CSP hashes and integrity.
import alpineLinuxIcon from '@iconify/icons-simple-icons/alpinelinux';
import anacondaIcon from '@iconify/icons-simple-icons/anaconda';
import archLinuxIcon from '@iconify/icons-simple-icons/archlinux';
import centOsIcon from '@iconify/icons-simple-icons/centos';
import debianIcon from '@iconify/icons-simple-icons/debian';
import deepinIcon from '@iconify/icons-simple-icons/deepin';
import dockerIcon from '@iconify/icons-simple-icons/docker';
import fedoraIcon from '@iconify/icons-simple-icons/fedora';
import firefoxIcon from '@iconify/icons-simple-icons/firefox';
import gentooIcon from '@iconify/icons-simple-icons/gentoo';
import gnuIcon from '@iconify/icons-simple-icons/gnu';
import gnuEmacsIcon from '@iconify/icons-simple-icons/gnuemacs';
import homebrewIcon from '@iconify/icons-simple-icons/homebrew';
import kaliIcon from '@iconify/icons-simple-icons/kalilinux';
import linuxIcon from '@iconify/icons-simple-icons/linux';
import linuxMintIcon from '@iconify/icons-simple-icons/linuxmint';
import llvmIcon from '@iconify/icons-simple-icons/llvm';
import manjaroIcon from '@iconify/icons-simple-icons/manjaro';
import npmIcon from '@iconify/icons-simple-icons/npm';
import openSuseIcon from '@iconify/icons-simple-icons/opensuse';
import openWrtIcon from '@iconify/icons-simple-icons/openwrt';
import pythonIcon from '@iconify/icons-simple-icons/python';
import qtIcon from '@iconify/icons-simple-icons/qt';
import raspberryPiIcon from '@iconify/icons-simple-icons/raspberrypi';
import rockyIcon from '@iconify/icons-simple-icons/rockylinux';
import rosIcon from '@iconify/icons-simple-icons/ros';
import rustIcon from '@iconify/icons-simple-icons/rust';
import ubuntuIcon from '@iconify/icons-simple-icons/ubuntu';

import { themeArtwork } from '../themes/artwork';
import SiteLayout from '../layouts/SiteLayout.astro';
import { folderIcon } from '../lib/ui-icons';

interface StaticIcon {
  width: number;
  height: number;
  body: string;
}

function staticIcon(value: unknown): StaticIcon {
  const module = value as { default?: StaticIcon };
  return module.default ?? (value as StaticIcon);
}

const iconGroups: Array<{ ids: string[]; icon: StaticIcon }> = [
  { ids: ['alpine'], icon: staticIcon(alpineLinuxIcon) },
  { ids: ['anaconda'], icon: staticIcon(anacondaIcon) },
  { ids: ['archlinux', 'archlinuxcn'], icon: staticIcon(archLinuxIcon) },
  { ids: ['centos', 'centos-vault'], icon: staticIcon(centOsIcon) },
  { ids: ['debian'], icon: staticIcon(debianIcon) },
  { ids: ['deepin'], icon: staticIcon(deepinIcon) },
  { ids: ['docker-ce'], icon: staticIcon(dockerIcon) },
  { ids: ['fedora'], icon: staticIcon(fedoraIcon) },
  { ids: ['mozilla'], icon: staticIcon(firefoxIcon) },
  {
    ids: ['gentoo', 'gentoo-portage', 'gentoo-portage.git'],
    icon: staticIcon(gentooIcon),
  },
  { ids: ['gnu'], icon: staticIcon(gnuIcon) },
  { ids: ['elpa'], icon: staticIcon(gnuEmacsIcon) },
  { ids: ['homebrew'], icon: staticIcon(homebrewIcon) },
  { ids: ['kali'], icon: staticIcon(kaliIcon) },
  { ids: ['linux.git'], icon: staticIcon(linuxIcon) },
  { ids: ['linuxmint'], icon: staticIcon(linuxMintIcon) },
  { ids: ['llvm-apt'], icon: staticIcon(llvmIcon) },
  { ids: ['manjaro'], icon: staticIcon(manjaroIcon) },
  { ids: ['npm'], icon: staticIcon(npmIcon) },
  { ids: ['opensuse'], icon: staticIcon(openSuseIcon) },
  { ids: ['openwrt'], icon: staticIcon(openWrtIcon) },
  { ids: ['pypi'], icon: staticIcon(pythonIcon) },
  { ids: ['qt'], icon: staticIcon(qtIcon) },
  {
    ids: ['raspberrypi', 'raspbian'],
    icon: staticIcon(raspberryPiIcon),
  },
  { ids: ['rocky'], icon: staticIcon(rockyIcon) },
  { ids: ['ros', 'ros2', 'rosdistro'], icon: staticIcon(rosIcon) },
  {
    ids: ['crates.io-index', 'crates.io-index.git', 'rustup'],
    icon: staticIcon(rustIcon),
  },
  { ids: ['ubuntu', 'ubuntu-ports'], icon: staticIcon(ubuntuIcon) },
];

const contentSecurityPolicy =
  "default-src 'none'; style-src 'self' 'unsafe-inline'; script-src AUTOINDEX_SCRIPT_HASHES; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; base-uri 'none'; form-action 'none'";
---

<SiteLayout
  title="Directory listing"
  lang="zh"
  canonicalPath="/autoindex/"
  pageKind="autoindex"
  contentSecurityPolicy={contentSecurityPolicy}
>
  <article class="autoindex-page">
    <section class="autoindex-hero" aria-labelledby="listing-title">
      <h1 id="listing-title" class="autoindex-title">Mirror</h1>
      <div class="autoindex-status-row">
        <span id="mirror-status" class="status status-unknown">UNKNOWN</span>
        <span id="mirror-updated" class="autoindex-updated" hidden></span>
      </div>
      <div
        id="autoindex-watermark"
        class="autoindex-watermark"
        aria-hidden="true"
      >
        <span id="autoindex-theme-artwork" class="theme-mirror-artwork"></span>
        {
          iconGroups.flatMap(({ ids, icon }) =>
            ids.map((id) => (
              <svg
                class="autoindex-watermark-icon"
                data-mirror-icon={id}
                viewBox={`0 0 ${icon.width} ${icon.height}`}
                focusable="false"
              >
                <g set:html={icon.body} />
              </svg>
            ))
          )
        }
      </div>
    </section>

    <section class="autoindex-panel" aria-labelledby="listing-path-heading">
      <h2 id="listing-path-heading" class="autoindex-path-heading">
        <svg
          viewBox={`0 0 ${folderIcon.width} ${folderIcon.height}`}
          aria-hidden="true"
        >
          <g set:html={folderIcon.body} />
        </svg>
        <span>Index of <code id="listing-path">/</code></span>
      </h2>
      <div
        class="autoindex-listing"
        role="region"
        aria-label="Directory entries"
        tabindex="0"
      >
        <noscript>
          <p class="autoindex-noscript">
            浏览目录列表需要启用 JavaScript。也可以直接获取服务器返回的 JSON
            目录列表，例如{' '}
            <code>
              {'curl https://mirrors.zju.edu.cn/debian/.mirror-index/'}
            </code>
            。
          </p>
        </noscript>
        <p id="autoindex-message" class="autoindex-message" role="status"></p>
        <table id="autoindex-list" hidden>
          <thead>
            <tr>
              <th scope="col" data-sort-key="name">
                <button type="button" class="autoindex-sort">
                  File Name
                </button>
              </th>
              <th scope="col" data-sort-key="size">
                <button type="button" class="autoindex-sort">
                  File Size
                </button>
              </th>
              <th scope="col" data-sort-key="mtime">
                <button type="button" class="autoindex-sort">Date</button>
              </th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
        <nav
          id="autoindex-pagination"
          class="autoindex-pagination"
          aria-label="目录分页"
          hidden
        >
          <button id="autoindex-previous" type="button">上一页</button>
          <span id="autoindex-page-label" aria-live="polite"></span>
          <button id="autoindex-next" type="button">下一页</button>
        </nav>
      </div>
    </section>
  </article>

  <script
    is:inline
    define:vars={{
      artworkByMirror: Object.fromEntries(
        iconGroups.flatMap(({ ids }) => ids.map((id) => [id, themeArtwork(id)]))
      ),
      fallbackArtwork: themeArtwork('mirror'),
    }}
  >
    (() => {
      const icon = document.querySelector('#autoindex-theme-artwork');
      const id = location.pathname.split('/').filter(Boolean)[0]?.toLowerCase();
      if (icon)
        for (const [key, value] of Object.entries(
          artworkByMirror[id] || fallbackArtwork
        ))
          icon.style.setProperty(key, value);
    })();
  </script>
  <script>
    import '../scripts/autoindex.js';
  </script>
</SiteLayout>
