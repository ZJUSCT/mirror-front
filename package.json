{
  "name": "zju-mirror",
  "private": true,
  "description": "Zhejiang University open-source mirror portal",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.15.1"
  },
  "scripts": {
    "build": "astro build && node scripts/generate-autoindex.mjs",
    "dev": "astro dev --host 0.0.0.0",
    "dev:review": "MIRROR_FRONT_REVIEW_FIXTURES=1 astro dev --host 0.0.0.0",
    "preview": "astro preview --host 0.0.0.0",
    "format": "prettier --write src scripts statistics-exporter/*.mjs statistics-exporter/*.json *.mjs *.json .github/workflows",
    "check": "astro check",
    "test": "node --test statistics-exporter/exporter.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.7",
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource/poppins": "5.2.7",
    "@iconify-icons/devicon": "2.0.0",
    "@iconify/icons-ic": "1.2.13",
    "@iconify/icons-logos": "1.2.36",
    "@iconify/icons-simple-icons": "1.2.74",
    "astro": "7.2.4",
    "fuse.js": "7.1.0",
    "highlight.js": "11.11.1",
    "marked": "18.0.10",
    "mustache": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "2.17.7",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/mustache": "4.2.6",
    "@types/node": "22.20.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/sanitize-html": "2.16.1",
    "prettier": "3.7.4",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZJUSCT/mirror-front"
  },
  "bugs": {
    "url": "https://github.com/ZJUSCT/mirror-front/issues"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ],
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
