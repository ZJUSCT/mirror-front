# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm

ARG DEV_UID=1000
ARG DEV_GID=1000
ARG PNPM_VERSION=10.15.1

ENV ASTRO_TELEMETRY_DISABLED=1 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

WORKDIR /app

RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate

COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,id=mirror-front-dev-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Corepack otherwise stores its prepared pnpm runtime under root's home,
# forcing the non-root development user to download it again at startup.
ENV COREPACK_HOME=/corepack
RUN mkdir -p /corepack && corepack prepare "pnpm@${PNPM_VERSION}" --activate

RUN groupmod --gid "${DEV_GID}" node && \
    usermod --uid "${DEV_UID}" --gid "${DEV_GID}" node && \
    mkdir -p \
      /app/.astro \
      /app/.cache \
      /app/dist \
      /corepack \
      /pnpm/store && \
    chown -R node:node /app /corepack /home/node /pnpm

USER node

CMD ["pnpm", "dev"]
